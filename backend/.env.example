# Copy this file to .env and fill in what you have. Everything is optional: with no keys the app runs in DEMO mode.

# Gemini API key from https://aistudio.google.com/apikey  (turns on the real Google ADK agent)
GOOGLE_API_KEY=
# Gemini model name. Check https://ai.google.dev/gemini-api/docs/models for currently supported names.
GEMINI_MODEL=gemini-2.5-flash



DATABASE_URL=sqlite:///./travel_agent.db
# Comma separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# Login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# Public address of the website (used in the sitemap)
PUBLIC_URL=http://localhost:5173

# ---- Travel features ----
# Where travel-memory photos and videos are stored (a private folder on this computer). Use S3 for production.
UPLOAD_DIR=uploads
MEMORY_QUOTA_MB=500
# Optional live fuel price provider (none is bundled). Edit parse_provider_response in app/services/fuel.py to match your provider.
FUEL_PRICE_API_URL=
FUEL_PRICE_API_KEY=
